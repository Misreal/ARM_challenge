# Dataset (re-downloadable, ~340 MB)
# Leading slash anchors this to the repo root. Without it, "data/" would match a
# directory named "data" at ANY depth and silently exclude src/data/ too.
/data/

# Large training outputs: regenerate by re-running training
artifacts/checkpoints/
artifacts/onnx/

# Quantized candidates: one .onnx per config hash, thousands over a campaign.
# Regenerated deterministically from the config in the sidecar .json; the
# summary numbers that matter live in artifacts/reports/.
artifacts/quant/

# Pi evaluation bundles: ~12 MB of raw pixels, regenerated bit-for-bit by
# `python -m src.data.export_pi_data` from the committed split. The manifest
# beside them is NOT ignored -- it carries the preprocessing contract and the
# checksums that let the Pi verify it received the right arrays.
artifacts/pi_data/*.npy

# The sealed test bundle, same reasoning at 29 MB, regenerated by
# `python -m src.data.export_test_bundle --confirm`.
artifacts/pi_test_data/*.npy

# NOTE: artifacts/splits/ and artifacts/reports/ are deliberately NOT ignored.
#
#   splits/cifar100_split.json  MUST travel with the repo. Stage 0 (local) and
#     training (Thunder box) have to use the identical partition, or calibration
#     and optimization-validation images leak into training and every downstream
#     accuracy number becomes unsound. Committing it is what makes the file's
#     fingerprint check meaningful across machines.
#   reports/*.json              is the Stage 0 -> Stage 1 contract. Small, and
#     worth having in history to compare baselines over time.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Test runner output
.pytest_cache/
.pytest_temp/
artifacts/reports/custom_cnn_latency_amd64.json

# Environments
.venv/
venv/
.env

# Editors / tooling
.vscode/
*.log

# OS cruft
Thumbs.db
.DS_Store

# Device connection settings: one operator's hostname, user and key path.
# Committing them would point a fresh clone at a machine that isn't theirs.
pi_target.json

# Personal file
CLAUDE.md
PLAN.md
APP_PLAN.md
project_idea.md
.claude/
personal_notes.md
CODEX_WORK.md
.agents/
competition_rules.md
# Optuna study state: binary and rewritten on every resume. The .json
# summaries next to it carry the results that matter.
artifacts/search/*.db

# Scratch: mock runs, probe scripts, anything not a measured result.
scratch/

# Simulated runs. Bundled runs are measured runs; the app suffixes mock ones.
runs/*_mock/

# Simulated study summaries, same reasoning as the mock runs.
artifacts/search/*_mock.json

# Graphs handed to src.import_onnx: someone else's weights, tens of MB each, and
# the baseline report already records the sha256 that identifies the one used.
imports/

# Scratch that landed at the repo root: a study dump and a five-line timm probe.
convergence.json
huggingface_model_test.py
