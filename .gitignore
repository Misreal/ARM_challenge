# Dataset, re-downloadable (~340 MB)
/data/

# Large training outputs, regenerate by re-running training
artifacts/checkpoints/
artifacts/onnx/

# Quantized candidates, regenerated deterministically from sidecar .json configs
artifacts/quant/

# Pi eval bundles, regenerated by src.data.export_pi_data
artifacts/pi_data/*.npy

# Sealed test bundle, regenerated by src.data.export_test_bundle --confirm
artifacts/pi_test_data/*.npy

# NOTE: artifacts/splits/ and artifacts/reports/ are NOT ignored on purpose
# (split must match across machines; reports are the Stage 0 -> Stage 1 contract)

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Test runner output
.pytest_cache/
.pytest_temp/
artifacts/reports/custom_cnn_latency_amd64.json

# Environments
.venv/
venv/
.env

# Editors / tooling
.vscode/
*.log

# OS cruft
Thumbs.db
.DS_Store

# Device connection settings, machine-specific
pi_target.json

# Personal / planning docs
CLAUDE.md
PLAN.md
APP_PLAN.md
project_idea.md
.claude/
personal_notes.md
CODEX_WORK.md
.agents/
competition_rules.md

# Optuna study state, binary and rewritten on every resume
artifacts/search/*.db

# Scratch: mock runs, probe scripts, anything not a measured result
scratch/

# Simulated runs
runs/*_mock/
artifacts/search/*_mock.json

# Imported ONNX graphs, tens of MB each
imports/

# Stray scratch files at repo root
convergence.json
huggingface_model_test.py

# Paper drafts, kept out of the code history
paper/
